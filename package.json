{
	"name": "SparkCall",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"packager:start": "react-native start",
		"packager:start-adb": "adb reverse tcp:8081 tcp:8081 && yarn run packager:start",
		"packager:start-fresh": "yarn run packager:clear-watchman && yarn run packager:start --reset-cache",
		"packager:clear-watchman": "watchman watch-del-all",
		"android": "react-native run-android --no-packager",
		"android:interactive": "yarn run android --interactive",
		"android:debug": "yarn run android --mode debug && yarn packager:start-fresh",
		"android:release": "yarn run android --mode release",
		"ios": "react-native run-ios --no-packager",
		"ios:interactive": "yarn run ios --interactive",
		"ios:debug": "yarn run ios --mode Debug && yarn packager:start-fresh",
		"ios:release": "yarn run ios --mode Release",
		"ios:pod-install": "cd ios && bundle install && bundle exec pod install",
		"lint:eslint": "eslint . --ext .js,.jsx,.ts,.tsx",
		"lint:eslint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
		"lint:types": "tsc --noEmit",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"test": "jest --watchman=false",
		"test:ci": "jest --coverage --watchman=false",
		"refresh": "rm -rf node_modules && yarn rebuild"
	},
	"dependencies": {
		"@react-native/new-app-screen": "0.84.1",
		"@react-navigation/native": "^7.1.33",
		"@react-navigation/native-stack": "^7.14.5",
		"mediasoup-client": "^3.18.7",
		"protoo-client": "^4.0.8",
		"react": "19.2.3",
		"react-native": "0.84.1",
		"react-native-bootsplash": "^7.1.0",
		"react-native-gesture-handler": "^2.30.0",
		"react-native-nitro-modules": "^0.35.2",
		"react-native-reanimated": "^4.2.2",
		"react-native-safe-area-context": "^5.7.0",
		"react-native-screens": "^4.24.0",
		"react-native-unistyles": "^3.1.1",
		"react-native-webrtc": "github:EdgarJMesquita/react-native-webrtc#39cde3d1e3dd80cb81e4c71680f0ce9a7d63f6d8",
		"react-native-worklets": "^0.7.4"
	},
	"devDependencies": {
		"@babel/core": "^7.25.2",
		"@babel/preset-env": "^7.25.3",
		"@babel/runtime": "^7.25.0",
		"@eslint-react/eslint-plugin": "^3.0.0",
		"@eslint/eslintrc": "^3.3.5",
		"@eslint/js": "^10.0.1",
		"@react-native-community/cli": "20.1.0",
		"@react-native-community/cli-platform-android": "20.1.0",
		"@react-native-community/cli-platform-ios": "20.1.0",
		"@react-native/babel-preset": "0.84.1",
		"@react-native/eslint-config": "0.84.1",
		"@react-native/metro-config": "0.84.1",
		"@react-native/typescript-config": "0.84.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@tanstack/eslint-plugin-query": "^5.91.4",
		"@testing-library/react-native": "^13.3.3",
		"@types/jest": "^29.5.13",
		"@types/react": "^19.2.0",
		"@types/react-test-renderer": "^19.1.0",
		"babel-plugin-module-resolver": "^5.0.3",
		"eslint": "^9.37.0",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-de-morgan": "^2.1.1",
		"eslint-plugin-format": "^2.0.1",
		"eslint-plugin-import-x": "^4.16.2",
		"eslint-plugin-jsonc": "^3.1.2",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-regexp": "^3.1.0",
		"eslint-plugin-sonarjs": "^4.0.2",
		"eslint-plugin-unicorn": "^63.0.0",
		"eslint-plugin-unused-imports": "^4.4.1",
		"globals": "^17.4.0",
		"jest": "^29.6.3",
		"jest-junit": "^16.0.0",
		"prettier": "^3.8.1",
		"react-test-renderer": "19.2.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.1"
	},
	"engines": {
		"node": ">= 22.11.0"
	},
	"packageManager": "yarn@4.9.2"
}
